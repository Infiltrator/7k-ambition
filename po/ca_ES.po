msgstr ""
"Un espia del Regne de %s%s ha estat descobert i executat al teu cau Fryhtan "
"a prop de %s."

msgid ""
"A spy from %s's Kingdom%s has been uncovered and executed in your Harbor "
"near %s."
msgstr ""
"Un espia del Regne de %s%s ha estat descobert i executat al teu port a prop "
"de %s."

msgid ""
"A spy from %s's Kingdom%s has been uncovered and executed in your Inn near "
"%s."
msgstr ""
