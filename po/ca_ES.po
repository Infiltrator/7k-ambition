msgstr ""
"Un espia del Regne de %s%s ha estat descobert i executat al teu Tron de "
"Poder a prop de %s."

msgid ""
"A spy from %s's Kingdom%s has been uncovered and executed in your Tower of "
"Science near %s."
msgstr ""
"Un espia del Regne de %s%s ha estat descobert i executat a la teva torre de "
"la ciència a prop de %s."

msgid ""
"A spy from %s's Kingdom%s has been uncovered and executed in your War "
"Factory near %s."
msgstr ""
"Un espia del Regne de %s%s ha estat descobert i executat a la teva fàbrica "
